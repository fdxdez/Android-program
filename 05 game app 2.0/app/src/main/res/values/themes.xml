<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        实验五补充说明：Android Studio 新版本的主题会覆盖按钮背景，
        导致按钮设置 backgroundTint 后没有变化，因此父主题必须使用
        MaterialComponents 的 Bridge 变体：Theme.MaterialComponents.*.Bridge。

        这里使用 DayNight.DarkActionBar.Bridge：
        - DayNight：跟随系统深浅色模式；
        - DarkActionBar：应用自带顶部 ActionBar，主界面的菜单（关于）就放在这里。
    -->
    <style name="Base.Theme.GameApp20" parent="Theme.MaterialComponents.DayNight.DarkActionBar.Bridge">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/text_on_brand</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorSecondaryVariant">@color/brand_secondary_dark</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:windowBackground">@color/screen_background</item>
        <item name="android:colorBackground">@color/screen_background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/surface_card</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <!-- 顶部 ActionBar：背景使用品牌色，标题与图标使用白色 -->
        <item name="actionBarStyle">@style/Widget.App.ActionBar</item>
        <item name="actionBarTheme">@style/ThemeOverlay.App.ActionBar</item>
        <item name="actionBarPopupTheme">@style/ThemeOverlay.App.ActionBarPopup</item>

        <!-- 对话框统一使用圆角浅色样式 -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.MaterialAlertDialog</item>
    </style>

    <style name="Theme.GameApp20" parent="Base.Theme.GameApp20" />

    <style name="Widget.App.ActionBar" parent="Widget.MaterialComponents.ActionBar.Primary">
        <item name="background">@color/brand_primary</item>
        <item name="titleTextStyle">@style/TextAppearance.App.ActionBarTitle</item>
        <item name="subtitleTextStyle">@style/TextAppearance.App.ActionBarSubtitle</item>
    </style>

    <style name="TextAppearance.App.ActionBarTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/text_on_brand</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="TextAppearance.App.ActionBarSubtitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/text_on_brand</item>
    </style>

    <!-- ActionBar 内部的图标（返回箭头、菜单按钮）保持白色 -->
    <style name="ThemeOverlay.App.ActionBar" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar">
        <item name="colorControlNormal">@color/text_on_brand</item>
        <item name="android:textColorPrimary">@color/text_on_brand</item>
        <item name="android:textColorSecondary">@color/text_on_brand</item>
    </style>

    <!-- 菜单弹出框：浅色背景 + 深色文字 -->
    <style name="ThemeOverlay.App.ActionBarPopup" parent="ThemeOverlay.MaterialComponents.Light">
        <item name="android:textColorPrimary">@color/text_primary</item>
    </style>

    <style name="ThemeOverlay.App.MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.Dialog</item>
        <item name="colorPrimary">@color/brand_primary</item>
    </style>

    <style name="ShapeAppearance.App.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <!-- 统计条与信息卡片的通用样式 -->
    <style name="Widget.App.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!--
        按钮统一样式。
        MaterialButton 默认上下各有 6dp 的 inset（背景比控件矮一截），并且默认高度是固定的，
        系统字体放大时文字容易被裁掉；这里去掉 inset，改用「最小高度 + 上下内边距」让按钮自己撑开，
        并显式设置文字居中，保证文字在任何字体大小下都完整、居中显示。
    -->
    <style name="Widget.App.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">@dimen/button_vertical_padding</item>
        <item name="android:paddingBottom">@dimen/button_vertical_padding</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">@dimen/button_text_size</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.App.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">@dimen/button_vertical_padding</item>
        <item name="android:paddingBottom">@dimen/button_vertical_padding</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">@dimen/button_text_size</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/brand_primary</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
